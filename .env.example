# Copia este fichero como .env y rellénalo. El .env nunca se sube al repositorio.

# Puerto local de la app (el túnel de Cloudflare apunta aquí)
PORT=3000

# Email con Brevo (https://app.brevo.com > SMTP & API > API keys). Si lo dejas vacío, los emails se guardan en data/outbox.
BREVO_API_KEY=
SENDER_EMAIL=
# Avisos del vigilante (si falta, se usan SENDER_EMAIL)
ALERT_EMAIL=
SENDER_NAME=Escala (demo)
# Avisos de «Pedir que me llamen» al equipo (si falta, se usa SENDER_EMAIL)
TEAM_EMAIL=

# Alternativa a Brevo: cualquier SMTP, por ejemplo smtps://usuario:contraseña@smtp.servidor.com:465
SMTP_URL=

# Asistente de IA integrado en la web (opcional). Clave de https://console.anthropic.com
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Código que hay que escribir en el chat antes de usar el asistente (evita que cualquiera gaste tu saldo)
AGENT_PASSCODE=

# URL pública fija (opcional). Si no se pone, se toma de la primera visita a través del túnel.
PUBLIC_URL=
